{
  "$schema": "https://cdn.jsdelivr.net/gh/DogeLakeDev/ScriptsForMinecraftServer@main/modules/sdk/@sfmc-sdk/schemas/ui-screen.v1.schema.json",
  "formatVersion": 1,
  "id": "land.home",
  "name": "领地",
  "presentation": "menu",
  "title": "领地",
  "body": [
    {
      "id": "intro",
      "type": "info",
      "items": ["租用、续租和管理领地。"],
      "tone": "muted"
    },
    {
      "id": "list",
      "type": "button",
      "label": "我的领地",
      "trigger": {
        "type": "navigate",
        "to": "land.list"
      }
    },
    {
      "id": "lease",
      "type": "button",
      "label": "租用领地",
      "trigger": {
        "type": "navigate",
        "to": "land.lease"
      }
    },
    {
      "id": "close",
      "type": "button",
      "label": "关闭",
      "trigger": {
        "type": "close"
      }
    }
  ]
}
