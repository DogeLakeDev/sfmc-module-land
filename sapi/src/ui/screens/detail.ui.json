{
  "$schema": "https://cdn.jsdelivr.net/gh/DogeLakeDev/ScriptsForMinecraftServer@main/modules/sdk/@sfmc-sdk/schemas/ui-screen.v1.schema.json",
  "formatVersion": 1,
  "id": "land.detail",
  "name": "领地详情",
  "presentation": "reactive",
  "title": "{{data.land.name}}",
  "params": {
    "landId": {
      "type": "string",
      "required": true
    }
  },
  "state": {
    "expandLevel": {
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 5,
      "step": 1
    },
    "renewQuoteId": {
      "type": "string",
      "default": ""
    },
    "renewFee": {
      "type": "number",
      "default": 0
    },
    "expandQuoteId": {
      "type": "string",
      "default": ""
    },
    "expandFee": {
      "type": "number",
      "default": 0
    },
    "newDailyRent": {
      "type": "number",
      "default": 0
    },
    "quotedExpandLevel": {
      "type": "number",
      "default": 0
    },
    "daysOption": {
      "type": "number",
      "default": 7
    },
    "customDays": {
      "type": "string",
      "default": "7",
      "maxLength": 3
    },
    "quotedDaysOption": {
      "type": "number",
      "default": -1
    },
    "quotedCustomDays": {
      "type": "string",
      "default": ""
    },
    "quotedRenewDays": {
      "type": "number",
      "default": 0
    }
  },
  "load": {
    "land": {
      "service": "land.ui.detail",
      "input": {
        "playerId": "{{player.id}}",
        "landId": "{{params.landId}}"
      }
    }
  },
  "body": [
    {
      "id": "status",
      "type": "button",
      "label": "状态 · {{data.land.statusText}}",
      "trigger": {
        "type": "navigate",
        "to": "land.status",
        "params": {
          "landId": "{{params.landId}}"
        }
      }
    },
    {
      "id": "rename",
      "type": "button",
      "label": "修改名称",
      "disabledWhen": {
        "op": "not",
        "args": [
          {
            "ref": "data.land.canRename"
          }
        ]
      },
      "trigger": {
        "type": "navigate",
        "to": "land.rename",
        "params": {
          "landId": "{{params.landId}}"
        }
      }
    },
    {
      "id": "daysOption",
      "type": "dropdown",
      "label": "续租租期",
      "bind": "state.daysOption",
      "options": [
        {
          "label": "7 天",
          "value": 7
        },
        {
          "label": "14 天",
          "value": 14
        },
        {
          "label": "30 天",
          "value": 30
        },
        {
          "label": "90 天",
          "value": 90
        },
        {
          "label": "自定义",
          "value": 0
        }
      ]
    },
    {
      "id": "customDays",
      "type": "textField",
      "label": "自定义续租天数（1～90）",
      "bind": "state.customDays",
      "placeholder": "7",
      "visibleWhen": {
        "op": "equals",
        "args": [
          {
            "ref": "state.daysOption"
          },
          {
            "value": 0
          }
        ]
      }
    },
    {
      "id": "preview-renew",
      "type": "button",
      "label": "预览续租费用",
      "trigger": {
        "type": "action",
        "action": "previewRenew"
      },
      "disabledWhen": {
        "op": "not",
        "args": [
          {
            "ref": "data.land.canRenew"
          }
        ]
      }
    },
    {
      "id": "renew-quote",
      "type": "info",
      "items": ["续租费用：{{state.renewFee}}"]
    },
    {
      "id": "renew",
      "type": "button",
      "label": "确认续租",
      "tone": "primary",
      "trigger": {
        "type": "action",
        "action": "renew"
      },
      "disabledWhen": {
        "op": "or",
        "args": [
          {
            "op": "not",
            "args": [
              {
                "ref": "data.land.canRenew"
              }
            ]
          },
          {
            "op": "equals",
            "args": [
              {
                "ref": "state.renewQuoteId"
              },
              {
                "value": ""
              }
            ]
          },
          {
            "op": "notEquals",
            "args": [
              {
                "ref": "state.daysOption"
              },
              {
                "ref": "state.quotedDaysOption"
              }
            ]
          },
          {
            "op": "notEquals",
            "args": [
              {
                "ref": "state.customDays"
              },
              {
                "ref": "state.quotedCustomDays"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "renew-divider",
      "type": "divider"
    },
    {
      "id": "expand-level",
      "type": "dropdown",
      "label": "扩建等级",
      "bind": "state.expandLevel",
      "options": {
        "source": "data.land.expandLevels",
        "as": "level",
        "value": "{{level.value}}",
        "label": "{{level.label}}"
      },
      "disabledWhen": {
        "op": "not",
        "args": [
          {
            "ref": "data.land.canExpand"
          }
        ]
      }
    },
    {
      "id": "preview-expand",
      "type": "button",
      "label": "预览扩建并报价",
      "trigger": {
        "type": "action",
        "action": "previewExpand"
      },
      "disabledWhen": {
        "op": "not",
        "args": [
          {
            "ref": "data.land.canExpand"
          }
        ]
      }
    },
    {
      "id": "expand-quote",
      "type": "info",
      "items": [
        "扩建补差：{{state.expandFee}} · 新日租：{{state.newDailyRent}}"
      ]
    },
    {
      "id": "expand",
      "type": "button",
      "label": "确认扩建",
      "trigger": {
        "type": "action",
        "action": "expand"
      },
      "disabledWhen": {
        "op": "or",
        "args": [
          {
            "op": "not",
            "args": [
              {
                "ref": "data.land.canExpand"
              }
            ]
          },
          {
            "op": "equals",
            "args": [
              {
                "ref": "state.expandQuoteId"
              },
              {
                "value": ""
              }
            ]
          },
          {
            "op": "notEquals",
            "args": [
              {
                "ref": "state.expandLevel"
              },
              {
                "ref": "state.quotedExpandLevel"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "terminate",
      "type": "button",
      "label": "解除租赁",
      "tone": "danger",
      "trigger": {
        "type": "action",
        "action": "terminate"
      }
    },
    {
      "id": "back",
      "type": "button",
      "label": "返回",
      "trigger": {
        "type": "back"
      }
    }
  ],
  "actions": {
    "renew": {
      "call": {
        "service": "land.ui.renew",
        "input": {
          "playerId": "{{player.id}}",
          "landId": "{{params.landId}}",
          "quoteId": "{{state.renewQuoteId}}",
          "daysOption": "{{state.daysOption}}",
          "customDays": "{{state.customDays}}"
        }
      },
      "onSuccess": [
        {
          "effect": "setState",
          "values": {
            "renewQuoteId": "",
            "expandQuoteId": ""
          }
        },
        {
          "effect": "message",
          "text": "续租成功",
          "tone": "success"
        },
        {
          "effect": "refresh"
        }
      ],
      "onError": [
        {
          "effect": "message",
          "text": "续租失败：{{result.message}}",
          "tone": "danger"
        }
      ],
      "confirm": {
        "title": "确认续租",
        "body": "为「{{data.land.name}}」续租 {{state.quotedRenewDays}} 天，费用 {{state.renewFee}} 货币。"
      }
    },
    "previewExpand": {
      "call": {
        "service": "land.ui.previewExpand",
        "input": {
          "playerId": "{{player.id}}",
          "landId": "{{params.landId}}",
          "level": "{{state.expandLevel}}"
        }
      },
      "onSuccess": [
        {
          "effect": "setState",
          "values": {
            "expandQuoteId": "{{result.quoteId}}",
            "expandFee": "{{result.fee}}",
            "newDailyRent": "{{result.dailyRent}}",
            "quotedExpandLevel": "{{result.level}}"
          }
        },
        {
          "effect": "message",
          "text": "{{result.message}}"
        }
      ],
      "onError": [
        {
          "effect": "message",
          "text": "预览失败：{{result.message}}",
          "tone": "danger"
        }
      ]
    },
    "expand": {
      "confirm": {
        "title": "确认扩建",
        "body": "将「{{data.land.name}}」扩建至 {{state.expandLevel}} 级，补差 {{state.expandFee}} 货币，新日租 {{state.newDailyRent}}。"
      },
      "call": {
        "service": "land.ui.expand",
        "input": {
          "playerId": "{{player.id}}",
          "landId": "{{params.landId}}",
          "level": "{{state.expandLevel}}",
          "quoteId": "{{state.expandQuoteId}}"
        }
      },
      "onSuccess": [
        {
          "effect": "setState",
          "values": {
            "renewQuoteId": "",
            "expandQuoteId": ""
          }
        },
        {
          "effect": "message",
          "text": "扩建成功，补差 {{result.feeDiff}}",
          "tone": "success"
        },
        {
          "effect": "refresh"
        }
      ],
      "onError": [
        {
          "effect": "message",
          "text": "扩建失败：{{result.message}}",
          "tone": "danger"
        }
      ]
    },
    "terminate": {
      "confirm": {
        "title": "解除租赁",
        "body": "确认解除「{{data.land.name}}」的租赁？剩余租金不退还，范围立即释放。",
        "confirmText": "确认解除",
        "danger": true
      },
      "call": {
        "service": "land.ui.terminate",
        "input": {
          "playerId": "{{player.id}}",
          "landId": "{{params.landId}}",
          "requestId": "{{data.land.terminateRequestId}}"
        }
      },
      "onSuccess": [
        {
          "effect": "message",
          "text": "租赁已解除",
          "tone": "success"
        },
        {
          "effect": "replace",
          "to": "land.list"
        }
      ],
      "onError": [
        {
          "effect": "message",
          "text": "解除失败：{{result.message}}",
          "tone": "danger"
        }
      ]
    },
    "previewRenew": {
      "call": {
        "service": "land.ui.previewRenew",
        "input": {
          "playerId": "{{player.id}}",
          "landId": "{{params.landId}}",
          "daysOption": "{{state.daysOption}}",
          "customDays": "{{state.customDays}}"
        }
      },
      "onSuccess": [
        {
          "effect": "setState",
          "values": {
            "renewQuoteId": "{{result.quoteId}}",
            "renewFee": "{{result.fee}}",
            "quotedRenewDays": "{{result.days}}",
            "quotedDaysOption": "{{result.quotedDaysOption}}",
            "quotedCustomDays": "{{result.quotedCustomDays}}"
          }
        },
        {
          "effect": "message",
          "text": "{{result.message}}"
        }
      ],
      "onError": [
        {
          "effect": "message",
          "text": "预览失败：{{result.message}}",
          "tone": "danger"
        }
      ]
    }
  }
}
