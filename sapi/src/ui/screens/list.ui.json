{
  "$schema": "https://cdn.jsdelivr.net/gh/DogeLakeDev/ScriptsForMinecraftServer@main/modules/sdk/@sfmc-sdk/schemas/ui-screen.v1.schema.json",
  "formatVersion": 1,
  "id": "land.list",
  "name": "我的领地",
  "presentation": "menu",
  "title": "我的领地",
  "load": {
    "lands": {
      "service": "land.listByOwner",
      "input": {
        "ownerId": "{{player.id}}",
        "limit": 100
      }
    }
  },
  "body": [
    {
      "id": "count",
      "type": "info",
      "items": ["名下领地：{{data.lands.lands.length}} 块"]
    },
    {
      "id": "land-list",
      "type": "each",
      "source": "data.lands.lands",
      "as": "land",
      "template": [
        {
          "id": "land-row",
          "type": "button",
          "label": "{{land.name}} · {{land.statusText}} · 日租 {{land.dailyRent}}",
          "trigger": {
            "type": "navigate",
            "to": "land.detail",
            "params": {
              "landId": "{{land.id}}"
            }
          }
        }
      ],
      "empty": [
        {
          "id": "empty",
          "type": "info",
          "items": ["暂无领地，使用「租用领地」创建。"],
          "tone": "muted"
        }
      ]
    },
    {
      "id": "lease",
      "type": "button",
      "label": "租用领地",
      "trigger": {
        "type": "navigate",
        "to": "land.lease"
      }
    },
    {
      "id": "refresh",
      "type": "button",
      "label": "刷新",
      "trigger": {
        "type": "refresh"
      }
    },
    {
      "id": "back",
      "type": "button",
      "label": "返回",
      "trigger": {
        "type": "back"
      }
    }
  ]
}
