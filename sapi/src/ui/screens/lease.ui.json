{
  "$schema": "https://cdn.jsdelivr.net/gh/DogeLakeDev/ScriptsForMinecraftServer@main/modules/sdk/@sfmc-sdk/schemas/ui-screen.v1.schema.json",
  "formatVersion": 1,
  "id": "land.lease",
  "name": "租用领地",
  "presentation": "reactive",
  "title": "租用领地",
  "state": {
    "shapeType": {
      "type": "string",
      "default": "cuboid"
    },
    "x": {
      "type": "string",
      "default": "",
      "maxLength": 16
    },
    "y": {
      "type": "string",
      "default": "",
      "maxLength": 16
    },
    "z": {
      "type": "string",
      "default": "",
      "maxLength": 16
    },
    "length": {
      "type": "string",
      "default": "",
      "maxLength": 16
    },
    "width": {
      "type": "string",
      "default": "",
      "maxLength": 16
    },
    "height": {
      "type": "string",
      "default": "",
      "maxLength": 16
    },
    "radius": {
      "type": "string",
      "default": "",
      "maxLength": 16
    },
    "daysOption": {
      "type": "number",
      "default": 7
    },
    "customDays": {
      "type": "string",
      "default": "7",
      "maxLength": 3
    },
    "quoteId": {
      "type": "string",
      "default": ""
    },
    "fee": {
      "type": "number",
      "default": 0
    },
    "dailyRent": {
      "type": "number",
      "default": 0
    },
    "quotedDaysOption": {
      "type": "number",
      "default": -1
    },
    "quotedCustomDays": {
      "type": "string",
      "default": ""
    },
    "quoted_shapeType": {
      "type": "string",
      "default": ""
    },
    "quoted_x": {
      "type": "string",
      "default": ""
    },
    "quoted_y": {
      "type": "string",
      "default": ""
    },
    "quoted_z": {
      "type": "string",
      "default": ""
    },
    "quoted_length": {
      "type": "string",
      "default": ""
    },
    "quoted_width": {
      "type": "string",
      "default": ""
    },
    "quoted_height": {
      "type": "string",
      "default": ""
    },
    "quoted_radius": {
      "type": "string",
      "default": ""
    },
    "shapeText": {
      "type": "string",
      "default": ""
    },
    "rangeText": {
      "type": "string",
      "default": ""
    },
    "volume": {
      "type": "number",
      "default": 0
    }
  },
  "load": {
    "draft": {
      "service": "land.ui.leaseDraft",
      "input": {
        "playerId": "{{player.id}}"
      }
    }
  },
  "body": [
    {
      "id": "draft",
      "type": "info",
      "items": [
        "维度：{{data.draft.dimensionText}}",
        "初始选区：{{data.draft.shapeText}}",
        "{{data.draft.rangeText}}",
        "名称在租用成功后自动生成，可在管理页修改。"
      ]
    },
    {
      "id": "select",
      "type": "button",
      "label": "空手重新选点",
      "trigger": {
        "type": "action",
        "action": "select"
      }
    },
    {
      "id": "shapeType",
      "type": "dropdown",
      "label": "领地形状",
      "bind": "state.shapeType",
      "options": [
        {
          "label": "长方体",
          "value": "cuboid"
        },
        {
          "label": "圆柱体",
          "value": "cylinder"
        }
      ]
    },
    {
      "id": "position-help",
      "type": "info",
      "items": [
        "X/Z 为定位中心，Y 为底部高度。尺寸以方块计；留空沿用初始选区。"
      ]
    },
    {
      "id": "x",
      "type": "textField",
      "label": "中心 X",
      "bind": "state.x",
      "placeholder": "{{data.draft.x}}"
    },
    {
      "id": "y",
      "type": "textField",
      "label": "底部 Y",
      "bind": "state.y",
      "placeholder": "{{data.draft.y}}"
    },
    {
      "id": "z",
      "type": "textField",
      "label": "中心 Z",
      "bind": "state.z",
      "placeholder": "{{data.draft.z}}"
    },
    {
      "id": "length",
      "type": "textField",
      "label": "长（X 方向）",
      "bind": "state.length",
      "placeholder": "{{data.draft.length}}",
      "visibleWhen": {
        "op": "equals",
        "args": [
          {
            "ref": "state.shapeType"
          },
          {
            "value": "cuboid"
          }
        ]
      }
    },
    {
      "id": "width",
      "type": "textField",
      "label": "宽（Z 方向）",
      "bind": "state.width",
      "placeholder": "{{data.draft.width}}",
      "visibleWhen": {
        "op": "equals",
        "args": [
          {
            "ref": "state.shapeType"
          },
          {
            "value": "cuboid"
          }
        ]
      }
    },
    {
      "id": "radius",
      "type": "textField",
      "label": "圆柱体半径",
      "bind": "state.radius",
      "placeholder": "{{data.draft.radius}}",
      "visibleWhen": {
        "op": "equals",
        "args": [
          {
            "ref": "state.shapeType"
          },
          {
            "value": "cylinder"
          }
        ]
      }
    },
    {
      "id": "height",
      "type": "textField",
      "label": "高度",
      "bind": "state.height",
      "placeholder": "{{data.draft.height}}"
    },
    {
      "id": "daysOption",
      "type": "dropdown",
      "label": "租期",
      "bind": "state.daysOption",
      "options": [
        {
          "label": "7 天",
          "value": 7
        },
        {
          "label": "14 天",
          "value": 14
        },
        {
          "label": "30 天",
          "value": 30
        },
        {
          "label": "90 天",
          "value": 90
        },
        {
          "label": "自定义",
          "value": 0
        }
      ]
    },
    {
      "id": "customDays",
      "type": "textField",
      "label": "自定义天数（1～90）",
      "bind": "state.customDays",
      "placeholder": "7",
      "visibleWhen": {
        "op": "equals",
        "args": [
          {
            "ref": "state.daysOption"
          },
          {
            "value": 0
          }
        ]
      }
    },
    {
      "id": "preview",
      "type": "button",
      "label": "预览线框并估价",
      "trigger": {
        "type": "action",
        "action": "preview"
      }
    },
    {
      "id": "quote",
      "type": "info",
      "items": [
        "{{state.shapeText}} · 体积 {{state.volume}} 方块",
        "{{state.rangeText}}",
        "本次费用：{{state.fee}} · 日租：{{state.dailyRent}}",
        "修改选区或租期后，请重新预览。"
      ]
    },
    {
      "id": "create",
      "type": "button",
      "label": "确认租用",
      "tone": "primary",
      "trigger": {
        "type": "action",
        "action": "create"
      },
      "disabledWhen": {
        "op": "or",
        "args": [
          {
            "op": "equals",
            "args": [
              {
                "ref": "state.quoteId"
              },
              {
                "value": ""
              }
            ]
          },
          {
            "op": "notEquals",
            "args": [
              {
                "ref": "state.shapeType"
              },
              {
                "ref": "state.quoted_shapeType"
              }
            ]
          },
          {
            "op": "notEquals",
            "args": [
              {
                "ref": "state.x"
              },
              {
                "ref": "state.quoted_x"
              }
            ]
          },
          {
            "op": "notEquals",
            "args": [
              {
                "ref": "state.y"
              },
              {
                "ref": "state.quoted_y"
              }
            ]
          },
          {
            "op": "notEquals",
            "args": [
              {
                "ref": "state.z"
              },
              {
                "ref": "state.quoted_z"
              }
            ]
          },
          {
            "op": "notEquals",
            "args": [
              {
                "ref": "state.length"
              },
              {
                "ref": "state.quoted_length"
              }
            ]
          },
          {
            "op": "notEquals",
            "args": [
              {
                "ref": "state.width"
              },
              {
                "ref": "state.quoted_width"
              }
            ]
          },
          {
            "op": "notEquals",
            "args": [
              {
                "ref": "state.height"
              },
              {
                "ref": "state.quoted_height"
              }
            ]
          },
          {
            "op": "notEquals",
            "args": [
              {
                "ref": "state.radius"
              },
              {
                "ref": "state.quoted_radius"
              }
            ]
          },
          {
            "op": "notEquals",
            "args": [
              {
                "ref": "state.daysOption"
              },
              {
                "ref": "state.quotedDaysOption"
              }
            ]
          },
          {
            "op": "notEquals",
            "args": [
              {
                "ref": "state.customDays"
              },
              {
                "ref": "state.quotedCustomDays"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "back",
      "type": "button",
      "label": "返回",
      "trigger": {
        "type": "back"
      }
    }
  ],
  "actions": {
    "preview": {
      "call": {
        "service": "land.ui.previewLease",
        "input": {
          "playerId": "{{player.id}}",
          "shapeType": "{{state.shapeType}}",
          "x": "{{state.x}}",
          "y": "{{state.y}}",
          "z": "{{state.z}}",
          "length": "{{state.length}}",
          "width": "{{state.width}}",
          "height": "{{state.height}}",
          "radius": "{{state.radius}}",
          "daysOption": "{{state.daysOption}}",
          "customDays": "{{state.customDays}}"
        }
      },
      "onSuccess": [
        {
          "effect": "setState",
          "values": {
            "quoteId": "{{result.quoteId}}",
            "fee": "{{result.fee}}",
            "dailyRent": "{{result.dailyRent}}",
            "quotedDaysOption": "{{result.quotedDaysOption}}",
            "quotedCustomDays": "{{result.quotedCustomDays}}",
            "shapeText": "{{result.shapeText}}",
            "rangeText": "{{result.rangeText}}",
            "volume": "{{result.volume}}",
            "quoted_shapeType": "{{result.quoted_shapeType}}",
            "quoted_x": "{{result.quoted_x}}",
            "quoted_y": "{{result.quoted_y}}",
            "quoted_z": "{{result.quoted_z}}",
            "quoted_length": "{{result.quoted_length}}",
            "quoted_width": "{{result.quoted_width}}",
            "quoted_height": "{{result.quoted_height}}",
            "quoted_radius": "{{result.quoted_radius}}"
          }
        },
        {
          "effect": "message",
          "text": "{{result.message}}"
        }
      ],
      "onError": [
        {
          "effect": "message",
          "text": "预览失败：{{result.message}}",
          "tone": "danger"
        }
      ]
    },
    "create": {
      "confirm": {
        "title": "确认租用",
        "body": "确认租用 {{state.shapeText}}？费用 {{state.fee}} 货币。名称将自动生成。"
      },
      "call": {
        "service": "land.ui.createLease",
        "input": {
          "playerId": "{{player.id}}",
          "shapeType": "{{state.shapeType}}",
          "x": "{{state.x}}",
          "y": "{{state.y}}",
          "z": "{{state.z}}",
          "length": "{{state.length}}",
          "width": "{{state.width}}",
          "height": "{{state.height}}",
          "radius": "{{state.radius}}",
          "daysOption": "{{state.daysOption}}",
          "customDays": "{{state.customDays}}",
          "quoteId": "{{state.quoteId}}"
        }
      },
      "onSuccess": [
        {
          "effect": "message",
          "text": "已创建「{{result.name}}」，费用 {{result.fee}}",
          "tone": "success"
        },
        {
          "effect": "replace",
          "to": "land.detail",
          "params": {
            "landId": "{{result.landId}}"
          }
        }
      ],
      "onError": [
        {
          "effect": "message",
          "text": "租用失败：{{result.message}}",
          "tone": "danger"
        }
      ]
    },
    "select": {
      "call": {
        "service": "land.ui.beginSelection",
        "input": {
          "playerId": "{{player.id}}"
        }
      },
      "onSuccess": [
        {
          "effect": "message",
          "text": "{{result.message}}"
        },
        {
          "effect": "close"
        }
      ],
      "onError": [
        {
          "effect": "message",
          "text": "开启选点失败：{{result.message}}",
          "tone": "danger"
        }
      ]
    }
  }
}
