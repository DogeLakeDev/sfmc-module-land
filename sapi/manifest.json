{
  "$schema": "https://cdn.jsdelivr.net/gh/DogeLakeDev/ScriptsForMinecraftServer@main/modules/sdk/@sfmc-sdk/schemas/sapi-manifest.v2.schema.json",
  "schemaVersion": 2,
  "id": "land",
  "name": "领地",
  "configKey": "land",
  "enabledByDefault": true,
  "canDisable": true,
  "requires": ["economy", "activity-log"],
  "permissions": [
    "config:read:land",
    "db:read:sfmc_land_operations",
    "db:read:sfmc_lands",
    "db:write:sfmc_land_operations",
    "db:write:sfmc_lands",
    "service:activity.query",
    "service:activity.record",
    "service:economy.account.credit",
    "service:economy.account.debit",
    "service:land.auditLog",
    "service:land.byId",
    "service:land.byPos",
    "service:land.createLease",
    "service:land.expandLease",
    "service:land.leaseStatus",
    "service:land.listByOwner",
    "service:land.renewLease",
    "service:land.terminateLease",
    "service:land.ui.createLease",
    "service:land.ui.detail",
    "service:land.ui.expand",
    "service:land.ui.leaseDraft",
    "service:land.ui.previewExpand",
    "service:land.ui.previewLease",
    "service:land.ui.previewRenew",
    "service:land.ui.renew",
    "service:land.ui.terminate",
    "service:land.validateBox"
  ],
  "services": {
    "provides": [
      {
        "name": "land.auditLog",
        "input": {
          "type": "object",
          "properties": {
            "playerId": {
              "type": "string"
            },
            "landId": {
              "type": "string"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "offset": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["playerId", "landId"]
        },
        "output": {
          "type": "object"
        }
      },
      {
        "name": "land.byId",
        "input": {
          "type": "object",
          "properties": {
            "landId": {
              "type": "string"
            }
          },
          "required": ["landId"]
        },
        "output": {}
      },
      {
        "name": "land.byPos",
        "input": {
          "type": "object",
          "properties": {
            "dimension": {
              "type": "string",
              "enum": [
                "minecraft:overworld",
                "minecraft:nether",
                "minecraft:the_end"
              ]
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          },
          "required": ["dimension", "x", "y", "z"]
        },
        "output": {}
      },
      {
        "name": "land.createLease",
        "input": {
          "type": "object",
          "properties": {
            "playerId": {
              "type": "string"
            },
            "dimension": {
              "type": "string",
              "enum": [
                "minecraft:overworld",
                "minecraft:nether",
                "minecraft:the_end"
              ]
            },
            "requestId": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            },
            "expectedFee": {
              "type": "integer",
              "minimum": 0
            },
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90
            },
            "name": {
              "type": "string",
              "maxLength": 32
            },
            "min": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              },
              "required": ["x", "y", "z"]
            },
            "max": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              },
              "required": ["x", "y", "z"]
            },
            "core": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              },
              "required": ["x", "y", "z"]
            }
          },
          "required": ["playerId", "dimension", "requestId", "expectedFee"]
        },
        "output": {
          "type": "object"
        }
      },
      {
        "name": "land.expandLease",
        "input": {
          "type": "object",
          "properties": {
            "playerId": {
              "type": "string"
            },
            "landId": {
              "type": "string"
            },
            "requestId": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            },
            "expectedFee": {
              "type": "integer",
              "minimum": 0
            },
            "newMin": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              },
              "required": ["x", "y", "z"]
            },
            "newMax": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              },
              "required": ["x", "y", "z"]
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "playerId",
            "landId",
            "requestId",
            "expectedFee",
            "newMin",
            "newMax"
          ]
        },
        "output": {
          "type": "object"
        }
      },
      {
        "name": "land.leaseStatus",
        "input": {
          "type": "object",
          "properties": {
            "landId": {
              "type": "string"
            }
          },
          "required": ["landId"]
        },
        "output": {
          "type": "object"
        }
      },
      {
        "name": "land.listByOwner",
        "input": {
          "type": "object",
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "offset": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["ownerId"]
        },
        "output": {
          "type": "object"
        }
      },
      {
        "name": "land.renewLease",
        "input": {
          "type": "object",
          "properties": {
            "playerId": {
              "type": "string"
            },
            "landId": {
              "type": "string"
            },
            "requestId": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            },
            "expectedFee": {
              "type": "integer",
              "minimum": 0
            },
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": ["playerId", "landId", "requestId", "expectedFee"]
        },
        "output": {
          "type": "object"
        }
      },
      {
        "name": "land.terminateLease",
        "input": {
          "type": "object",
          "properties": {
            "playerId": {
              "type": "string"
            },
            "landId": {
              "type": "string"
            },
            "requestId": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": ["playerId", "landId", "requestId"]
        },
        "output": {
          "type": "object"
        }
      },
      {
        "name": "land.ui.createLease",
        "input": {
          "type": "object",
          "properties": {
            "playerId": {
              "type": "string"
            },
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90
            },
            "quoteId": {
              "type": "string"
            },
            "name": {
              "type": "string",
              "maxLength": 32
            }
          },
          "required": ["playerId", "days", "quoteId"]
        },
        "output": {
          "type": "object"
        }
      },
      {
        "name": "land.ui.detail",
        "input": {
          "type": "object",
          "properties": {
            "playerId": {
              "type": "string"
            },
            "landId": {
              "type": "string"
            }
          },
          "required": ["playerId", "landId"]
        },
        "output": {
          "type": "object"
        }
      },
      {
        "name": "land.ui.expand",
        "input": {
          "type": "object",
          "properties": {
            "playerId": {
              "type": "string"
            },
            "landId": {
              "type": "string"
            },
            "level": {
              "type": "integer",
              "minimum": 1
            },
            "quoteId": {
              "type": "string"
            }
          },
          "required": ["playerId", "landId", "level", "quoteId"]
        },
        "output": {
          "type": "object"
        }
      },
      {
        "name": "land.ui.leaseDraft",
        "input": {
          "type": "object",
          "properties": {
            "playerId": {
              "type": "string"
            }
          },
          "required": ["playerId"]
        },
        "output": {
          "type": "object"
        }
      },
      {
        "name": "land.ui.previewExpand",
        "input": {
          "type": "object",
          "properties": {
            "playerId": {
              "type": "string"
            },
            "landId": {
              "type": "string"
            },
            "level": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": ["playerId", "landId", "level"]
        },
        "output": {
          "type": "object"
        }
      },
      {
        "name": "land.ui.previewLease",
        "input": {
          "type": "object",
          "properties": {
            "playerId": {
              "type": "string"
            },
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90
            },
            "name": {
              "type": "string",
              "maxLength": 32
            }
          },
          "required": ["playerId", "days"]
        },
        "output": {
          "type": "object"
        }
      },
      {
        "name": "land.ui.previewRenew",
        "input": {
          "type": "object",
          "properties": {
            "playerId": {
              "type": "string"
            },
            "landId": {
              "type": "string"
            },
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90
            }
          },
          "required": ["playerId", "landId", "days"]
        },
        "output": {
          "type": "object"
        }
      },
      {
        "name": "land.ui.renew",
        "input": {
          "type": "object",
          "properties": {
            "playerId": {
              "type": "string"
            },
            "landId": {
              "type": "string"
            },
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90
            },
            "quoteId": {
              "type": "string"
            }
          },
          "required": ["playerId", "landId", "days", "quoteId"]
        },
        "output": {
          "type": "object"
        }
      },
      {
        "name": "land.ui.terminate",
        "input": {
          "type": "object",
          "properties": {
            "playerId": {
              "type": "string"
            },
            "landId": {
              "type": "string"
            },
            "requestId": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          },
          "required": ["playerId", "landId", "requestId"]
        },
        "output": {
          "type": "object"
        }
      },
      {
        "name": "land.validateBox",
        "input": {
          "type": "object",
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "dimension": {
              "type": "string",
              "enum": [
                "minecraft:overworld",
                "minecraft:nether",
                "minecraft:the_end"
              ]
            },
            "min": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              },
              "required": ["x", "y", "z"]
            },
            "max": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              },
              "required": ["x", "y", "z"]
            },
            "excludeLandId": {
              "type": "string"
            }
          },
          "required": ["ownerId", "dimension", "min", "max"]
        },
        "output": {
          "type": "object"
        }
      }
    ],
    "requires": [
      {
        "name": "economy.account.debit"
      },
      {
        "name": "economy.account.credit"
      },
      {
        "name": "activity.record"
      },
      {
        "name": "activity.query"
      }
    ]
  },
  "notes": "领地租赁、续租、扩建和租期管理。"
}
